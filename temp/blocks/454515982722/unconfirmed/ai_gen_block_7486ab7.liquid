{% doc %}
  @prompt
    Create a block with a rich text filed that is populate from meta product_description_2
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-metafield-richtext-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-metafield-richtext__content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: {{ block.settings.line_height }};
  }

  .ai-metafield-richtext__content-{{ ai_gen_id }} h1,
  .ai-metafield-richtext__content-{{ ai_gen_id }} h2,
  .ai-metafield-richtext__content-{{ ai_gen_id }} h3,
  .ai-metafield-richtext__content-{{ ai_gen_id }} h4,
  .ai-metafield-richtext__content-{{ ai_gen_id }} h5,
  .ai-metafield-richtext__content-{{ ai_gen_id }} h6 {
    color: {{ block.settings.heading_color }};
    margin-top: 1em;
    margin-bottom: 0.5em;
  }

  .ai-metafield-richtext__content-{{ ai_gen_id }} h1:first-child,
  .ai-metafield-richtext__content-{{ ai_gen_id }} h2:first-child,
  .ai-metafield-richtext__content-{{ ai_gen_id }} h3:first-child,
  .ai-metafield-richtext__content-{{ ai_gen_id }} h4:first-child,
  .ai-metafield-richtext__content-{{ ai_gen_id }} h5:first-child,
  .ai-metafield-richtext__content-{{ ai_gen_id }} h6:first-child {
    margin-top: 0;
  }

  .ai-metafield-richtext__content-{{ ai_gen_id }} p {
    margin-bottom: 1em;
  }

  .ai-metafield-richtext__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-metafield-richtext__content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-metafield-richtext__content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-metafield-richtext__content-{{ ai_gen_id }} ul,
  .ai-metafield-richtext__content-{{ ai_gen_id }} ol {
    margin-bottom: 1em;
    padding-left: 1.5em;
  }

  .ai-metafield-richtext__content-{{ ai_gen_id }} li {
    margin-bottom: 0.5em;
  }

  .ai-metafield-richtext__content-{{ ai_gen_id }} strong {
    font-weight: 600;
  }

  .ai-metafield-richtext__empty-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    font-style: italic;
    text-align: center;
    padding: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-metafield-richtext-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding_top | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px {{ block.settings.padding_bottom | times: 0.8 }}px;
    }

    .ai-metafield-richtext__content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-metafield-richtext-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if product.metafields.custom.product_description_2 != blank %}
    <div class="ai-metafield-richtext__content-{{ ai_gen_id }}">
      {{ product.metafields.custom.product_description_2 }}
    </div>
  {% else %}
    <div class="ai-metafield-richtext__empty-{{ ai_gen_id }}">
      No additional description available. Add content to the product_description_2 metafield.
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product description 2",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding horizontal",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line height",
      "options": [
        {
          "value": "1.2",
          "label": "Tight"
        },
        {
          "value": "1.5",
          "label": "Normal"
        },
        {
          "value": "1.8",
          "label": "Loose"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Links hover",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Product description 2"
    }
  ]
}
{% endschema %}